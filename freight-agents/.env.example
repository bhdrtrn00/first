# Anthropic API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Freightos Rate Estimator API key (optional — enables live ocean/air freight rates)
# Get yours at: https://www.freightos.com/freight-resources/api/
# When not set, freight rate tools fall back to simulation.
FREIGHTOS_API_KEY=your_freightos_api_key_here

# Set to "true" to use the Freightos sandbox instead of production
FREIGHTOS_SANDBOX=false
